generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  USER
  ADMIN
  VIEWER
}

enum ProjectStatus {
  PENDING
  DEPLOYING
  SUCCESS
  FAILED
}

model User {
  id          String    @id @default(uuid())
  name        String
  email       String    @unique
  password    String
  role        Role      @default(USER)
  createdAt   DateTime  @default(now())
  projects    Project[]
  deployments Deployment[] @relation("UserDeployments")
}

model Project {
  id               String        @id @default(uuid())
  name             String
  description      String?
  githubRepo       String
  ownerId          String
  owner            User          @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  deploymentStatus ProjectStatus @default(PENDING)
  createdAt        DateTime      @default(now())
  deployments      Deployment[]
}

enum DeploymentStatus {
  PENDING
  CLONING
  BUILDING
  STARTING
  RUNNING
  SUCCESS
  FAILED
  STOPPED
}

model Deployment {
  id            String           @id @default(uuid())
  status        DeploymentStatus @default(PENDING)
  imageTag      String?
  logs          String?          @db.Text
  buildLogs     String?          @db.Text
  deployedBy    String
  deployedByUser User            @relation("UserDeployments", fields: [deployedBy], references: [id], onDelete: Cascade)
  projectId     String
  project       Project          @relation(fields: [projectId], references: [id], onDelete: Cascade)
  
  // Real Deployment Engine Fields
  containerId   String?
  imageName     String?
  assignedPort  Int?
  deploymentUrl String?
  runtimeStatus String?          @default("STOPPED")
  deploymentType String?
  deployedPort   Int?
  composeProjectName String?
  
  startedAt     DateTime?
  stoppedAt     DateTime?
  deployedAt    DateTime         @default(now())
  updatedAt     DateTime         @updatedAt
  durationMs    Int?             @default(0)
}
