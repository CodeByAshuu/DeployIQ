generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  USER
  ADMIN
  VIEWER
}

enum ProjectStatus {
  PENDING
  DEPLOYING
  SUCCESS
  FAILED
}

enum DeploymentStatus {
  PENDING
  BUILDING
  SUCCESS
  FAILED
}

model User {
  id        String    @id @default(uuid())
  name      String
  email     String    @unique
  password  String
  role      Role      @default(USER)
  createdAt DateTime  @default(now())
  projects  Project[]
}

model Project {
  id          String       @id @default(uuid())
  name        String
  description String?
  githubRepo  String
  ownerId     String
  owner       User         @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  status      ProjectStatus @default(PENDING)
  createdAt   DateTime     @default(now())
  deployments Deployment[]
}

model Deployment {
  id        String   @id @default(uuid())
  status    String
  version   String
  logs      String?  @db.Text
  projectId String
  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
}

